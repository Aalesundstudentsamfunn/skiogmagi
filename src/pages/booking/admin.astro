---
import PageLayout from '../../layouts/PageLayout.astro';
import GlassPanel from '../../components/ui/GlassPanel.astro';
import '../../assets/styles/booking.css';
---
<PageLayout title="Administrer rombooking" description="Manuell romfordeling for Ski & Magi.">
  <section class="booking-shell relative z-10 mx-auto w-full max-w-5xl px-6 pb-16 pt-36 text-white">
    <h1 class="mb-6 text-3xl font-bold">Romfordeling</h1>
    <GlassPanel>
      <form id="admin-login" class="booking-ticket-row">
        <label class="booking-field">Administrasjonsnøkkel<input id="admin-token" type="password" required autocomplete="off" /></label>
        <button class="booking-primary" type="submit">Hent bookinger</button>
      </form>
      <p id="admin-message" role="status" class="booking-notice" hidden></p>
      <section id="admin-workspace" hidden>
        <div class="mt-5 flex flex-wrap gap-3"><button id="admin-refresh" class="booking-secondary">Oppdater</button><button id="admin-logout" class="booking-secondary">Logg ut</button></div>
        <p class="booking-notice">Velg ventende forespørsler som fyller et helt rom. Kontroller billetter for eventuelle ledsagere og avklar kjønn og romønsker med deltakerne. Tildelingen sender ingen e-post: kontakt hver romansvarlig etterpå. Romnummer fordeles separat på hotellet.</p>
        <p id="admin-capacity" class="mb-4"></p>
        <p id="admin-selected" aria-live="polite">Ingen forespørsler valgt.</p>
        <form id="admin-assignment" class="booking-section">
          <div class="booking-grid">
            <label class="booking-field">Romtype<select id="admin-room"><option value="3">3-mannsrom</option><option value="4">4-mannsrom</option></select></label>
            <label class="booking-field">Saksnotat / begrunnelse<textarea id="admin-note" rows="3" minlength="5" maxlength="2000" required placeholder="Hva er avklart med deltakerne?" /></label>
          </div>
          <label class="booking-consent"><input id="admin-checked" type="checkbox" required /><span>Jeg har kontrollert billettene og avklart romønsker og kjønn med deltakerne. Eventuell deling på tvers av ønsker er uttrykkelig avtalt.</span></label>
          <button id="admin-assign" class="booking-primary" type="submit">Tildel ett rom til valgte forespørsler</button>
        </form>
        <h2 class="mt-8 text-2xl font-bold">Bookinger og forespørsler</h2>
        <div id="admin-list"></div>
      </section>
    </GlassPanel>
  </section>
</PageLayout>
<script src="../../scripts/booking-admin.ts"></script>
