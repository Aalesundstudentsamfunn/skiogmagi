{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "astro/client"],
    "strict": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/lib/booking/**/*.ts",
    "src/pages/api/booking/**/*.ts",
    "src/scripts/booking*.ts",
    "netlify/functions/room-availability.ts",
    "tests/booking*.test.ts"
  ]
}
